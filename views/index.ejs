<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- STEP 1: Set page information -->
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Razorpay Payment Demo</title>
  </head>

  <body>
    <!-- STEP 2: Create payment UI -->
    <h1>Pay With Razorpay</h1>

    <label>Amount:</label>

    <input
      type="number"
      id="amount"
      placeholder="Enter amount in INR"
    />

    <button id="pay-button">
      Pay Now
    </button>

    <!-- STEP 3: Load Razorpay Checkout -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script>
      // STEP 4: Add click event to Pay button
      document
        .querySelector("#pay-button")
        .addEventListener("click", async function () {
          try {
            // STEP 5: Get amount from input
            const amount =
              document.querySelector("#amount").value;

            // STEP 6: Validate amount
            if (!amount || amount <= 0) {
              alert("Please enter a valid amount");
              return;
            }

            // STEP 7: Create order on backend
            const response = await fetch("/create-order", {
              method: "POST",

              headers: {
                "Content-Type": "application/json",
              },

              body: JSON.stringify({
                amount: amount,
              }),
            });

            // STEP 8: Get order details
            const order = await response.json();

            // Check order creation
            if (!response.ok) {
              alert(
                order.error || "Order creation failed"
              );
              return;
            }

            console.log("Order:", order);

            // STEP 9: Set Razorpay checkout options
            const options = {
              // Razorpay Key ID from backend
              key: "<%= key %>",

              // Order amount
              amount: order.amount,

              // Currency
              currency: order.currency,

              // Business name
              name: "Razorpay Payment Demo",

              // Payment description
              description: "Test Transaction",

              // Razorpay Order ID
              order_id: order.id,

              // STEP 10: Handle successful payment
              handler: async function (response) {
                console.log(
                  "Payment Response:",
                  response
                );

                // STEP 11: Send payment details to backend
                const verifyResponse = await fetch(
                  "/verify-payment",
                  {
                    method: "POST",

                    headers: {
                      "Content-Type":
                        "application/json",
                    },

                    body: JSON.stringify({
                      razorpay_order_id:
                        response.razorpay_order_id,

                      razorpay_payment_id:
                        response.razorpay_payment_id,

                      razorpay_signature:
                        response.razorpay_signature,
                    }),
                  }
                );

                // STEP 12: Check payment verification
                const result =
                  await verifyResponse.json();

                console.log(
                  "Verification:",
                  result
                );

                if (verifyResponse.ok) {
                  // STEP 13: Redirect to success page
                  window.location.href =
                    "/payment-success";
                } else {
                  alert(
                    "Payment verification failed"
                  );
                }
              },

              // STEP 14: Set checkout theme
              theme: {
                color: "#3399cc",
              },
            };

            // STEP 15: Create Razorpay instance
            const rzp = new Razorpay(options);

            // STEP 16: Open Razorpay Checkout
            rzp.open();
          } catch (error) {
            // STEP 17: Handle errors
            console.error(
              "Payment Error:",
              error
            );

            alert(
              "Something went wrong. Please try again."
            );
          }
        });
    </script>
  </body>
</html>